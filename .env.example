# --- Models ------------------------------------------------------------------
# Which laya checkpoints may load (comma-separated). Empty = all three.
#   english | multilingual | typed-decisions
LAYA_MODELS=
# Which checkpoint to use by default. "auto" lets laya's Router pick per request (recommended).
LAYA_DEFAULT_MODEL=auto
# Inference device: auto | cpu | cuda.
LAYA_DEVICE=auto
# Load the checkpoints at startup (a few seconds) instead of on first call.
LAYA_PRELOAD=false

# --- Privacy / network -------------------------------------------------------
# laya runs locally and no request data ever leaves the machine. The only network access is the
# ONE-TIME download of checkpoints from Hugging Face. It is DISABLED by default: pre-fetch the models
# once with this set to true, then run fully offline. Set true only when you want that download.
LAYA_ALLOW_DOWNLOAD=false
# Hugging Face token, only needed for gated/private checkpoints during that download.
HF_TOKEN=

# --- Request bounds ----------------------------------------------------------
LAYA_MAX_INPUT_CHARS=20000
LAYA_MAX_QUESTIONS=32

# --- Answer honesty ----------------------------------------------------------
# Flag (never silently trust) answers below this calibrated confidence. 0 = don't flag; e.g. 0.6.
LAYA_MIN_CONFIDENCE=0.0

# --- Logging -----------------------------------------------------------------
# Emit a JSON audit line to stderr per call.
LAYA_AUDIT_LOG=true
# Keep the input text OUT of the audit log (recommended). false logs sizes/ids only either way.
LAYA_REDACT_STATE=true
